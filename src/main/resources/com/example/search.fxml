<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SearchController">
   <children>
      <Label text="好みに合った本を探そう">
         <font>
            <Font name="System Bold" size="24.0" />
         </font></Label>
      <Label text="読みたい本の条件を選択してください。">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label text="読みたいジャンル">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ComboBox fx:id="genreComBox" prefWidth="150.0" />
      <Label text="本の長さ">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ComboBox fx:id="lengthComBox" prefWidth="150.0" />
      <Button fx:id="searchButton" mnemonicParsing="false" text="おすすめの本を検索" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
